{
  "name": "digital-dhamma-library",
  "private": true,
  "version": "0.5.0",
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12.1.0"
  },
  "scripts": {
    "dev": "npm --workspace @digital-dhamma-library/web run dev",
    "build": "npm run validate:data && npm --workspace @digital-dhamma-library/web run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:data": "node scripts/validate-data.mjs",
    "build:research-index": "node scripts/build-research-index.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
