# GitHub Pages/static build
NEXT_PUBLIC_BASE_PATH=/digital-dhamma-library

# Optional LAN development HMR origins, comma-separated
NEXT_ALLOWED_DEV_ORIGINS=192.168.1.13

# Optional Phase 3 / Workspace 2.0 cloud persistence.
# Use the Supabase project URL and publishable key only.
# Never put a Supabase service_role/secret key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
