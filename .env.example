# GitHub Pages/static build
NEXT_PUBLIC_BASE_PATH=/digital-dhamma-library

# Optional LAN development HMR origins, comma-separated
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1,192.168.1.13

# Supabase browser client (safe publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
